# What an editor needs to write a file of this repository the way it is kept; the formatters
# (clang-format, ruff, ESLint) and scripts/check-text.mjs hold the rest.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,h,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
